      "parameters": {
        "jsCode": "// Mapea el formulario completo de primera consulta a campos de Supabase + GHL\nconst body = $input.first().json.body ?? $input.first().json;\n\nreturn [{\n  json: {\n    paciente_id: body.paciente_id,\n    ghl_contact_id: body.ghl_contact_id,\n    expediente: {\n      tipo_lactancia: body.lactancia_tipo,\n      duracion_lactancia_meses: body.lactancia_duracion_meses,\n      edad_ablactacion_meses: body.edad_ablactacion_meses,\n      alimentos_introducidos: body.alimentos_introducidos,\n      fam_eii: !!body.fam_eii,\n      fam_celiaquia: !!body.fam_celiaquia,\n      fam_intolerancia_lactosa: !!body.fam_intolerancia_lactosa,\n      fam_atopia: !!body.fam_atopia,\n      fam_alergias: body.fam_alergias,\n      dx_erge: !!body.dx_erge,\n      dx_estrenimiento_cronico: !!body.dx_estrenimiento_cronico,\n      dx_aplv: !!body.dx_aplv,\n      dx_intol_lactosa: !!body.dx_intol_lactosa,\n      dx_celiaquia: !!body.dx_celiaquia,\n      dx_crohn: !!body.dx_crohn,\n      dx_cuci: !!body.dx_cuci,\n      bristol: body.bristol,\n      frecuencia_evacuaciones_semana: body.frecuencia_evacuaciones,\n      reflujo: !!body.reflujo,\n      vomitos: !!body.vomitos,\n      alergias_medicamentos: body.alergias_medicamentos,\n      hospitalizaciones_previas: body.hospitalizaciones_previas,\n      cirugias_previas: body.cirugias_previas,\n      notas_generales: body.notas\n    },\n    antropometria: body.peso_kg && body.talla_cm ? {\n      peso_kg: body.peso_kg,\n      talla_cm: body.talla_cm,\n      perimetro_cefalico_cm: body.perimetro_cefalico_cm || null\n    } : null\n  }\n}];"
      },
