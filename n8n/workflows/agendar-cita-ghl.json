          "id": "ghl-api-key",
          "name": "GHL Private API Key"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"cita_id\": \"{{$('Supabase · Insert Cita').first().json.id}}\", \"ghl_appointment_id\": \"{{$('GHL · Crear Cita').first().json.id}}\" }"
      },
      "id": "10",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
