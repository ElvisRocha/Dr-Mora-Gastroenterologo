          "name": "Supabase Gastro Kids"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "no-reply@gastrokids.mx",
        "toEmail": "={{$('Preparar Datos').first().json.tutor.email}}",
        "subject": "Confirmación de cita · Gastro Kids",
        "emailType": "html",
        "message": "<div style=\"font-family:'Plus Jakarta Sans',Arial,sans-serif;color:#0F1A2E;padding:24px;\"><h2 style=\"color:#1F4068\">Cita confirmada</h2><p>Hola {{$('Preparar Datos').first().json.tutor.nombre}},</p><p>Tu cita para <strong>{{$('Preparar Datos').first().json.paciente.nombre}}</strong> está confirmada para el <strong>{{$('Preparar Datos').first().json.fecha}} a las {{$('Preparar Datos').first().json.hora}}</strong>.</p><p>Servicio: {{$('Preparar Datos').first().json.servicio_slug}}.</p><p style=\"margin-top:24px\">Gastro Kids · Dr. Alfredo Mora</p></div>",
        "options": {}
      },
      "id": "8",
      "name": "Email · Tutor",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1780, 220],
      "credentials": {
        "smtp": {
          "id": "smtp-gastrokids",
          "name": "SMTP Gastro Kids"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/conversations/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Version", "value": "2021-04-15" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"WhatsApp\",\n  \"contactId\": \"{{$('GHL · Upsert Contacto').first().json.contact.id}}\",\n  \"message\": \"Gastro Kids · Cita confirmada para {{$('Preparar Datos').first().json.paciente.nombre}} el {{$('Preparar Datos').first().json.fecha}} a las {{$('Preparar Datos').first().json.hora}}. Te esperamos.\"\n}",
        "options": {}
      },
      "id": "9",
      "name": "WhatsApp · Tutor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 380],
      "credentials": {
