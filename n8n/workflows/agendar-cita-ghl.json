            { "fieldId": "estado", "fieldValue": "agendada" },
            { "fieldId": "ghl_appointment_id", "fieldValue": "={{$json.id}}" },
            { "fieldId": "notas", "fieldValue": "={{$('Preparar Datos').first().json.motivo}}" }
          ]
        }
      },
      "id": "7",
      "name": "Supabase · Insert Cita",
      "type": "n8n-nodes-base.supabase",
