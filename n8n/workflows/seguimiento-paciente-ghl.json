      "id": "1",
      "name": "Webhook · seguimiento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Updates parciales de revisita: solo campos enviados se aplican\nconst body = $input.first().json.body ?? $input.first().json;\nconst pacienteId = body.paciente_id;\nconst campos = body.campos || {};\n\nconst patch = {};\nfor (const [k, v] of Object.entries(campos)) {\n  if (v !== undefined && v !== null && v !== '') patch[k] = v;\n}\n\nconst antropo = body.antropometria || null;\n\nreturn [{\n  json: { paciente_id: pacienteId, patch, antropometria: antropo, ghl_contact_id: body.ghl_contact_id || null }\n}];"
      },
      "id": "2",
      "name": "Construir Patch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update expediente_master set\n  bristol = coalesce({{$json.patch.bristol ? `'${$json.patch.bristol}'` : 'null'}}, bristol),\n  frecuencia_evacuaciones_semana = coalesce({{$json.patch.frecuencia_evacuaciones_semana || 'null'}}, frecuencia_evacuaciones_semana),\n  reflujo = coalesce({{$json.patch.reflujo ?? 'null'}}, reflujo),\n  vomitos = coalesce({{$json.patch.vomitos ?? 'null'}}, vomitos),\n  notas_generales = coalesce({{$json.patch.notas_generales ? `'${$json.patch.notas_generales}'` : 'null'}}, notas_generales),\n  updated_at = now()\nwhere paciente_id = '{{$json.paciente_id}}';"
      },
      "id": "3",
      "name": "Postgres · Update Expediente",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [680, 300],
